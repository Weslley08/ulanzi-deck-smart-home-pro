{
  "Author": "Weslley08",
  "Name": "Smart Home PRO",
  "Description": "Control Home Assistant, SmartThings, and Tuya devices with per-provider setup",
  "Version": "0.1.0",
  "Category": "Smart Home",
  "UUID": "com.ulanzi.smarthomepro.ulanziPlugin",
