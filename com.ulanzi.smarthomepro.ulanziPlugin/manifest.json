      "Icon": "resources/brand-home-assistant.svg",
      "PropertyInspectorPath": "property-inspector/provider/inspector.html",
      "Tooltip": "Configure Home Assistant connection and control a device",
      "state": 0,
      "States": [
        {
          "Name": "Off",
          "Image": "resources/off.svg"
        },
        {
          "Name": "On",
          "Image": "resources/on.svg"
        },
        {
          "Name": "Offline",
          "Image": "resources/offline.svg"
        },
        {
          "Name": "Not configured",
          "Image": "resources/offline.svg"
        }
      ],
      "DisableAutomaticStates": true,
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ],
      "Devices": []
    },
    {
