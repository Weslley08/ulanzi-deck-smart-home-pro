{
  "name": "ulanzi-deck-smart-home-pro",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Smart Home PRO plugin for Ulanzi Studio",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.12.2"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/runtime.js && node --check src/ha-provider.js && node --check src/registry.js",
    "start": "node src/runtime.js",
    "audit": "npm audit --omit=dev",
    "build:plugin": "node scripts/build.mjs",
    "setup": "npm ci --ignore-scripts && npm ci --prefix com.ulanzi.smarthomepro.ulanziPlugin --ignore-scripts",
    "typecheck": "npm run check",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js"
  },
  "dependencies": {
    "ws": "8.22.1"
  }
}
